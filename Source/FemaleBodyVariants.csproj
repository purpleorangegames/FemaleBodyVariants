<Project Sdk="Microsoft.NET.Sdk">
  <!-- builds for 1.7 by default, use -p:RimWorldVersion=1.6 for the 1.6 version -->
  <PropertyGroup>
    <RimWorldVersion Condition="'$(RimWorldVersion)' == ''">1.7</RimWorldVersion>
    <AssemblyName>FemaleBodyVariants</AssemblyName>
    <RootNamespace>FemaleBodyVariants</RootNamespace>
    <Version>2.0.0</Version>
    <Authors>tiagocc0</Authors>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <OutputPath>../$(RimWorldVersion)/Assemblies/</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldVersion)' == '1.7'">
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RimWorldVersion)' == '1.6'">
    <TargetFramework>net472</TargetFramework>
  </PropertyGroup>

  <!-- reference only, the game and the Harmony mod provide the real dlls -->
  <ItemGroup Condition="'$(RimWorldVersion)' == '1.7'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4985-unstable" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Lib.Harmony.Ref" Version="3.0.0-rc.3" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(RimWorldVersion)' == '1.6'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Lib.Harmony.Ref" Version="2.4.1" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
</Project>
